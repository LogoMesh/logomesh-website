# LogoMesh website — local environment
#
# Copy to `.env.local` for local dev.

# Backend base URL. The Next.js API routes proxy to <BASE>/api/installations/...
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Set to 1 to bypass the backend entirely and serve a per-process in-memory
# mock from lib/mock-backend.ts. Useful when the FastAPI service isn't running.
NEXT_PUBLIC_USE_MOCK_BACKEND=0

# Public host that appears inside generated webhook URLs returned to users.
# Defaults to https://api.logomesh.dev when unset.
# NEXT_PUBLIC_PUBLIC_HOST=https://api.logomesh.dev
